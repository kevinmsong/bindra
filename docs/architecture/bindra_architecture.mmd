flowchart TB

%% Palette: Okabe-Ito, which stays distinguishable under all three common
%% colour-vision deficiencies. Nothing is distinguished by hue alone -- every
%% planned block is also dashed and prefixed, so the figure survives greyscale.

subgraph IN["INPUTS"]
  direction LR
  SEQ["<b>Protein sequence</b><br/>One amino-acid string per target.<br/>Median 454 residues, longest 34,350."]
  SMI["<b>Ligand SMILES</b><br/>One text string per molecule, standardised<br/>so the same compound always spells the same."]
end

subgraph PROT["PROTEIN SIDE — frozen, never trained"]
  ESMC["<b>ESM-C 600M protein language model</b><br/>Turns a sequence into one vector per residue.<br/>573,632,640 weights, all frozen: fine-tuning it<br/>against 572 effective target units would fit the<br/>targets rather than the interaction."]
  CACHE[("<b>Residue-vector cache</b> · 14.0 GiB<br/>All 10,820 targets encoded once, offline.<br/>Re-encoding reproduces it bit-for-bit, which<br/>is what makes reuse safe.")]
  ESMC -->|"encoded once, offline"| CACHE
end

subgraph LIGSEAM["LIGAND SIDE — LiGhT-mini · 1,050,904 wts"]
  direction LR
  BUILD["<b>Batch builder</b><br/>Turns SMILES into graphs across 8 worker<br/>processes. Fingerprints and properties are read<br/>from a precomputed 3.8 GiB cache rather than<br/>recalculated: they were 81% of this step's cost."]

  subgraph ARMLIGHT["LiGhT — a transformer over bonds"]
    direction TB
    KFEAT["<b>Line graph + knowledge inputs</b><br/>The molecule is rewritten so each <i>bond</i> is a<br/>node. Two extra nodes carry whole-molecule<br/>facts: a 512-bit structural fingerprint and 200<br/>computed properties such as size and greasiness."]
    KLIGHT["<b>8 transformer layers, 8 heads, width 96</b><br/>Each bond repeatedly looks at bonds up to five<br/>atoms away and updates what it represents.<br/>Trained from scratch; a pre-training pass over<br/>547,629 molecules is available."]
    KREAD["<b>Molecule summary → 288 numbers</b><br/>Fingerprint node, property node, and the<br/>average over bonds — kept as three separate<br/>parts rather than blended into one."]
    KFEAT --> KLIGHT --> KREAD
  end

  CONTRACT["<b>The seam: what the ligand hands over</b><br/>One vector per bond, plus two masks. The first<br/>says which entries are real rather than padding;<br/>the second says which may be <i>drawn on a<br/>molecule</i>. The two knowledge nodes are real —<br/>the protein attends to them — but not drawable.<br/>Conflating those two questions is what previously<br/>forced them to be discarded."]

  BUILD --> ARMLIGHT
  KLIGHT --> CONTRACT
  KREAD --> CONTRACT
end

subgraph ADPT["SHARED ADAPTERS — one copy · 151,968 weights"]
  direction LR
  AP["<b>Protein → width 96</b><br/>1152 numbers per residue, narrowed."]
  AL["<b>Bonds → width 96</b><br/>96 numbers per bond, normalised."]
  AG["<b>Molecule summary → 3 × 96</b><br/>Each part projected separately, so the<br/>fingerprint is never averaged together<br/>with the computed properties."]
end

FILM["<b>Knowledge conditioning (FiLM)</b> · 74,496 weights<br/>The molecule's global properties <i>rescale</i> every residue and<br/>every bond, rather than merely being appended at the end.<br/>A quantity that is only appended can be ignored; one that<br/>multiplies cannot. Starts as an exact no-op, so switching it<br/>off compares the same model rather than a different one."]

subgraph FUSE["PROTEIN MEETS LIGAND — 4×8 heads · 598,272 wts"]
  direction TB
  P2L["<b>Protein looks at ligand</b><br/>Each residue spreads its attention over<br/>the molecule's bonds."]
  L2P["<b>Ligand looks at protein</b><br/>Each bond spreads its attention over<br/>the residues."]
  NOTE["Two separate sets of weights, run side by side.<br/>Neither sees the other's output, and one is<br/><b>not</b> the transpose of the other."]
  FFP["Protein refinement<br/>96 → 192 → 96, then re-masked"]
  FFL["Ligand refinement<br/>96 → 192 → 96, then re-masked"]
  P2L --- NOTE --- L2P
  P2L --> FFP
  L2P --> FFL
end

POOL["<b>One vector for the pair</b> — 576 numbers, six blocks<br/>Fused residues · fused bonds · the protein <i>before</i> fusion ·<br/>fingerprint · properties · bond average.<br/>That pre-fusion block is a route to an answer which does<br/>not depend on attention having found anything useful."]

subgraph HEAD["THREE PREDICTORS · 194,403 weights"]
  direction LR
  HKD["<b>pKd</b><br/>576 → 96 → 96 → 1"]
  HKI["<b>pKi</b><br/>576 → 96 → 96 → 1"]
  HIC["<b>pIC50</b><br/>576 → 96 → 96 → 1"]
end

GATHER{{"<b>Score only the endpoint that was measured</b><br/>Kd, Ki and IC50 are different experiments and are never<br/>mixed. A measurement that does not exist cannot be given<br/>a stand-in value, because no such value is representable."}}

subgraph LOSS["HOW ERROR IS COUNTED"]
  direction LR
  LEX["<b>Exact measurements</b><br/>Error smaller than the laboratory's own<br/>repeat scatter is free: 0.945 for Kd,<br/>0.641 Ki, 0.671 IC50."]
  LCEN["<b>Censored measurements</b> (16.6%)<br/>Records saying only 'weaker than 10 µM'.<br/>Penalised for crossing the bound, never<br/>for landing anywhere inside it."]
  LAUX["<b>Lower-confidence records</b><br/>Down-weighted to 0.25 and kept<br/>structurally apart, so they cannot<br/>influence the main term."]
end

IBAM["<b>iBAM — what the model looked at</b><br/>Every attention map kept per layer and per head,<br/>unaveraged: 32 protein↔ligand, 64 bond↔bond.<br/>──────────────<br/><b>Residue × bond</b> is native here, because a token <i>is</i> a<br/>bond. Residue × atom is derived and labelled as such.<br/>Rows always sum to one, so rows rank nothing — column<br/>totals are the orderable direction.<br/>──────────────<br/><b>Bond map</b>: which parts of a molecule shaped which<br/>other parts. Gated by a control that asks whether it says<br/>more than 'things near each other are related'."]

subgraph PUNC["UNCERTAINTY — built, needs 3 models"]
  direction TB
  UENS["<b>Ensemble</b><br/>Three separately trained models; their<br/>disagreement is a rough confidence signal.<br/>Three passes over <i>one</i> model is refused in<br/>code — it yields a convincing-looking spread<br/>that means nothing."]
  UCONF["<b>Calibrated intervals</b><br/>Split conformal on a held-apart slice, per<br/>endpoint. Too few points to support the<br/>quantile returns a <i>status</i>, never an<br/>invented interval."]
  UDOM["<b>Is this input familiar?</b><br/>Similarity to training molecules only, computed<br/>without looking at the ensemble — models can<br/>agree confidently about something they have<br/>never seen."]
  UENS --> UCONF --> UDOM
end

LOCK{{"<b>Benchmark lock</b><br/>Refuses to score a model on the sealed panels when its<br/>training set overlaps them. Measured from the split's own<br/>records, not guessed from its name: random split 60–100%<br/>overlap, cold-target 66–69%, <b>time-based split 0%</b> — the<br/>only one that qualifies. Opening the panels is logged and<br/>cannot be undone."}}

FISHING["<b>Drug fishing</b> — an evaluation, not a component<br/>3,721 targets · 81,971 actives · 37,187 measured inactives ·<br/>1,926,939 property-matched decoys. Ranking actives against<br/>decoys is a question asked of a finished model, so it needs<br/>no separate tower of its own."]

subgraph PDIFF["✎ ANALOG GENERATION — NOT BUILT"]
  direction TB
  DCOND["<b>What the generator would be told</b><br/>Target, endpoint, the seed molecule, what the<br/>model attended to, and which part of the<br/>scaffold must be preserved."]
  DDEN["<b>Discrete graph diffusion</b><br/>Atoms and bonds corrupted to noise by category<br/>and denoised back, with the protected scaffold<br/>held fixed throughout."]
  DDEC["<b>Back to a real molecule</b><br/>Decoded with RDKit, sanitised, scaffold<br/>re-checked by atom mapping. Validity reported<br/>before and after any repair."]
  DNO{{"Never shown the answer it is predicting — that is<br/>unavailable at inference and would teach it to copy.<br/>Sampling a molecule is not differentiable, so<br/>gradients stop here."}}
  DCOND --> DDEN --> DDEC
  DDEN --- DNO
end

PLOSS["✎ <b>PLANNED: the full training objective</b><br/>Affinity + ranking + generation + measured-change terms.<br/>Only the affinity term exists today."]

SEQ --> ESMC
SMI --> BUILD
CACHE -->|"one vector per residue"| AP
CONTRACT -->|"one vector per bond"| AL
CONTRACT -->|"molecule summary"| AG

AG --> FILM
AP --> FILM
AL --> FILM
FILM --> P2L
FILM --> L2P

FFP --> POOL
FFL --> POOL
AG --> POOL
AP -.->|"pre-fusion route"| POOL

POOL --> HKD & HKI & HIC
HKD & HKI & HIC --> GATHER
GATHER --> LEX & LCEN & LAUX
GATHER --> UENS
GATHER -.->|"a finished model"| LOCK
LOCK -.-> FISHING
P2L -.-> IBAM
L2P -.-> IBAM
KLIGHT -.->|"bond↔bond attention"| IBAM
IBAM -.->|"what to edit"| DCOND
DDEC -.-> PLOSS

%% Okabe-Ito. Blue = frozen, sky = trained, green = the seam, orange =
%% conditioning, vermillion = a refusal, yellow = loss, pink = planned.
classDef frozen fill:#DCE6F1,stroke:#0072B2,stroke-width:2px,color:#102A43
classDef trained fill:#D7EEF7,stroke:#56B4E9,stroke-width:2px,color:#0B3C52
classDef seam fill:#D8EFE4,stroke:#009E73,stroke-width:2px,color:#06402B
classDef conditioning fill:#FDEBD6,stroke:#E69F00,stroke-width:3px,color:#5A3A00
classDef gate fill:#FBE0D8,stroke:#D55E00,stroke-width:2px,color:#5C2206
classDef lossbox fill:#FBF4D4,stroke:#B8960B,stroke-width:2px,color:#4A3B00
classDef planned fill:#F0E4F3,stroke:#CC79A7,stroke-width:2px,stroke-dasharray:6 4,color:#4F2443
classDef note fill:#F5F5F5,stroke:#767676,stroke-width:1px,color:#333333,font-style:italic
classDef io fill:#FFFFFF,stroke:#1A1A1A,stroke-width:2px,color:#1A1A1A

class ESMC,CACHE frozen
class KFEAT,KLIGHT,KREAD,AP,AL,AG,P2L,L2P,FFP,FFL,POOL,HKD,HKI,HIC trained
class BUILD,CONTRACT seam
class FILM conditioning
class GATHER,LOCK,DNO gate
class LEX,LCEN,LAUX lossbox
class UENS,UCONF,UDOM trained
class DCOND,DDEN,DDEC,PLOSS planned
class NOTE,IBAM,FISHING note
class SEQ,SMI io
