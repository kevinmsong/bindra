class ESMC,CACHE frozen
class FEAT,LPROJ,GAT,READ,AP,AL,AG trained
class P2L,L2P,FFP,FFL,POOL fusion
class HKD,HKI,HIC trained
class LEX,LCEN,LAUX lossbox
class GATHER gate
class NOTE,IBAM note
class SEQ,SMI io
