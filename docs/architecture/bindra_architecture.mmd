flowchart TB

%% Solid = the trained v2-mid path. Dashed = built and tested, never trained.

subgraph IN["INPUTS"]
  direction LR
  SEQ["Protein sequence<br/>median 454 aa, max 34,350"]
  SMI["Ligand SMILES<br/>standardized, InChIKey-keyed"]
end

subgraph PROT["PROTEIN ENCODER — FROZEN"]
  ESMC["ESM-C 600M @ fcc9d36f<br/>573,632,640 params · 0 trainable<br/>2,046-residue windows, mean-merged"]
  CACHE[("Feature cache<br/>14.023 GiB bf16 · 44 shards<br/>10,820 constructs, bit-identical")]
  ESMC -->|"encode once"| CACHE
end

subgraph LIGSEAM["LIGAND ARM — ONE CONTRACT, TWO IMPLEMENTATIONS"]
  direction LR
  BUILD["LigandBatchBuilder<br/>carries the arm NAME, so it and its<br/>featurizer pickle for the process pool<br/>72% of the batch build, GIL-bound in RDKit<br/>only SMILES cross; the ~144 MiB protein<br/>tensor never does"]

  subgraph ARMGAT["GATv2 — TRAINED · 2,101,120 params"]
    direction TB
    FEAT["Atom graph · 78-dim atom, 12-dim bond<br/>bit-identical to legacy layout"]
    GAT["5 x GATv2Layer, 8 heads, dim 320<br/>edge-conditioned logits, self-loop flag<br/>segment softmax over incoming edges"]
    READ["mean || max → 640"]
    FEAT --> GAT --> READ
  end

  subgraph ARMLIGHT["LiGhT-mini — BUILT AND TESTED, NEVER TRAINED · 2,232,352 params"]
    direction TB
    KFEAT["Line graph + knowledge inputs<br/>137-dim atom, 14-dim bond<br/>512-bit fingerprint, 200 descriptors<br/>descriptors dominate; computed in the pool"]
    KLIGHT["LiGhT triplet transformer, pure PyTorch<br/>6.9e-06 vs the DGL reference<br/>dim 192, 4 layers, 8 heads<br/>──────────────<br/>trains EVERY weight from scratch:<br/>embeddings and attention biases included,<br/>which no partial-unfreeze setting reaches"]
    KREAD["fp || md || mean → 576"]
    DROP{{"knowledge nodes dropped<br/>from the token axis<br/>a fingerprint with a row in the<br/>attention map cannot be drawn on<br/>a molecule. Kept in the readout.<br/>Virtual-atom triplets are KEPT"}}
    KFEAT --> KLIGHT --> KREAD
    KLIGHT --> DROP
  end

  CONTRACT["FusionTokens — the seam<br/>tokens [B, T, token_dim] + mask · graph_states [B, graph_dim]<br/>──────────────<br/>each arm pads its OWN tokens: only the arm<br/>knows which are real<br/>GAT 1 token = 1 atom · 320 / 640<br/>LiGhT 1 token = 1 BOND · 192 / 576"]

  BUILD --> ARMGAT
  BUILD -.-> ARMLIGHT
  READ --> CONTRACT
  GAT --> CONTRACT
  KREAD -.-> CONTRACT
  DROP -.-> CONTRACT
end

subgraph ADPT["SHARED ADAPTERS — one instance, every task"]
  direction LR
  AP["protein<br/>LN#40;1152#41; → 320"]
  AL["ligand tokens<br/>LN#40;token_dim#41; → 320"]
  AG["ligand graph<br/>LN#40;graph_dim#41; → 320"]
  WIDTH["Widths READ OFF the arm's config —<br/>nothing downstream names an arm<br/>GAT 682,944 · LiGhT-mini 621,120"]
end

subgraph FUSE["BIDIRECTIONAL CROSS-ATTENTION — 2 layers x 8 heads · 4,931,840 params"]
  direction TB
  P2L["protein → ligand<br/>Q residues, K/V tokens<br/>masked by LIGAND mask"]
  L2P["ligand → protein<br/>Q tokens, K/V residues<br/>masked by PROTEIN mask"]
  NOTE["Separate parameters, run in PARALLEL<br/>NOT transposes of each other"]
  FFP["protein FFN 320-1280-320<br/>+ residual + LN + re-mask"]
  FFL["ligand FFN 320-1280-320<br/>+ residual + LN + re-mask"]
  P2L --- NOTE --- L2P
  P2L --> FFP
  L2P --> FFL
end

POOL["MASKED POOLING → [B, 1280]<br/>fused residues ++ fused tokens ++ ligand graph<br/>++ PRE-fusion protein mean<br/>the last is a path that does not depend on<br/>attention having found anything"]

subgraph HEAD["ENDPOINT HEADS — three INDEPENDENT trunks · 1,538,883 params"]
  direction LR
  HKD["pKd<br/>1280-320-320-1"]
  HKI["pKi<br/>1280-320-320-1"]
  HIC["pIC50<br/>1280-320-320-1"]
end

GATHER{{"gather ONLY the measured endpoint<br/>no fabricated zero label exists"}}

subgraph LOSS["LOSS = exact + 1.0 x censored + 0.25 x auxiliary"]
  direction LR
  LEX["EXACT · Huber, delta = measured sigma_rep<br/>Kd 0.945 · Ki 0.641 · IC50 0.671<br/>error inside the noise floor is free"]
  LCEN["CENSORED #40;16.6%#41; · one-sided hinge<br/>then the same Huber<br/>ZERO cost inside the bound"]
  LAUX["Tier B · weight 0.25<br/>structurally cannot reach<br/>the primary term"]
end

IBAM["iBAM export · p2l [B,8,L,T] · l2p [B,8,T,L] per layer<br/>unaveraged over heads · residue x token native,<br/>residue x atom DERIVED<br/>──────────────<br/>ranking uses l2p: p2l rows are softmax over tokens,<br/>so every residue total is 1 and cannot rank<br/>a LiGhT column is a BOND, not a triplet index"]

SEQ --> ESMC
SMI --> BUILD
CACHE -->|"[B, L, 1152] bf16"| AP
CONTRACT -->|"tokens + mask"| AL
CONTRACT -->|"graph_states"| AG

AP --> P2L
AP --> L2P
AL --> P2L
AL --> L2P

FFP --> POOL
FFL --> POOL
AG --> POOL
AP -.->|"pre-fusion bypass"| POOL

POOL --> HKD & HKI & HIC
HKD & HKI & HIC --> GATHER
GATHER --> LEX & LCEN & LAUX
P2L -.-> IBAM
L2P -.-> IBAM

