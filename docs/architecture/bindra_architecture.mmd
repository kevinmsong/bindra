flowchart TB

%% Solid = built and tested. Dotted + pencil = planned, no code exists.

subgraph IN["INPUTS"]
  direction LR
  SEQ["Protein sequence<br/>median 454 aa, max 34,350"]
  SMI["Ligand SMILES<br/>standardized, InChIKey-keyed"]
end

subgraph PROT["PROTEIN ENCODER — FROZEN"]
  ESMC["ESM-C 600M @ fcc9d36f<br/>573,632,640 params · 0 trainable<br/>2,046-residue windows, mean-merged"]
  CACHE[("Feature cache<br/>14.023 GiB bf16 · 44 shards<br/>10,820 constructs, bit-identical")]
  ESMC -->|"encode once"| CACHE
end

subgraph LIGSEAM["LIGAND ARM — LiGhT-mini · 1,050,904 params #40;52.7%#41;"]
  direction LR
  BUILD["LigandBatchBuilder<br/>carries the arm NAME, so it and its featurizer<br/>pickle for the process pool<br/>72% of the batch build, GIL-bound in RDKit<br/>only SMILES cross; the ~144 MiB protein tensor never does"]

  subgraph ARMLIGHT["LiGhT — trained FROM SCRATCH, no pre-training"]
    direction TB
    KFEAT["Line graph + knowledge inputs<br/>137-dim atom, 14-dim bond<br/>512-bit fingerprint, 200 descriptors<br/>descriptors dominate; computed in the pool"]
    KLIGHT["LiGhT triplet transformer, pure PyTorch<br/>PRE-TRAINABLE: bindra pretrain cross-predicts<br/>the masked knowledge nodes on train-only molecules<br/>6.9e-06 vs the DGL reference<br/>dim 96, 8 layers, 8 heads #40;head_dim 12#41;<br/>every weight trains: embeddings and attention<br/>biases included, which no partial unfreeze reaches"]
    KREAD["readout: fp ++ md ++ mean → 288"]
    KFEAT --> KLIGHT --> KREAD
  end

  CONTRACT["FusionTokens — the seam<br/>tokens [B, T, 96] + token_mask + PHYSICAL_MASK<br/>graph_states [B, 288]<br/>──────────────<br/>1 token = 1 BOND, or 1 unbonded atom,<br/>or a knowledge node<br/>knowledge nodes ATTEND but are not physical:<br/>two masks, because 'may attention see this'<br/>and 'may iBAM draw this' are different questions"]

  BUILD --> ARMLIGHT
  KLIGHT --> CONTRACT
  KREAD --> CONTRACT
end

subgraph ADPT["SHARED ADAPTERS — one instance, every task · 151,968 params"]
  direction LR
  AP["protein<br/>LN#40;1152#41; → 96"]
  AL["ligand tokens<br/>LN#40;96#41; → 96"]
  AG["ligand graph — ONE PROJECTION PER PART<br/>fp → 96 · md → 96 · mean → 96<br/>the readout is three things; compressing all<br/>of it into one block was the bottleneck"]
end

subgraph FUSE["BIDIRECTIONAL CROSS-ATTENTION — 4 layers x 8 heads, FFN x2 · 598,272 params #40;30.0%#41;"]
  direction TB
  P2L["protein → ligand<br/>Q residues, K/V tokens<br/>masked by LIGAND mask"]
  L2P["ligand → protein<br/>Q tokens, K/V residues<br/>masked by PROTEIN mask"]
  NOTE["Separate parameters, run in PARALLEL<br/>NOT transposes of each other"]
  FFP["protein FFN 96-192-96<br/>+ residual + LN + re-mask"]
  FFL["ligand FFN 96-192-96<br/>+ residual + LN + re-mask"]
  P2L --- NOTE --- L2P
  P2L --> FFP
  L2P --> FFL
end

POOL["MASKED POOLING → [B, 576] — SIX blocks<br/>fused residues ++ fused tokens ++ PRE-fusion protein<br/>++ fp ++ md ++ mean<br/>the pre-fusion block is a path that does not depend<br/>on attention having found anything"]

subgraph HEAD["ENDPOINT HEADS — three INDEPENDENT trunks · 194,403 params"]
  direction LR
  HKD["pKd<br/>576-96-96-1"]
  HKI["pKi<br/>576-96-96-1"]
  HIC["pIC50<br/>576-96-96-1"]
end

GATHER{{"gather ONLY the measured endpoint<br/>no fabricated zero label exists"}}

LOCK{{"BENCHMARK LOCK — bindra evaluate --panels<br/>──────────────<br/>refuses a checkpoint whose training set overlaps<br/>the sealed panels, measured against the split's own<br/>id files rather than assumed from the regime name<br/>random_pair 60.2% / 100.0% / 67.7%<br/>cold_target 66.4% / 68.8% / 67.6%<br/>temporal 0% — the only regime the panels can score<br/>──────────────<br/>opening them writes to an access log and cannot<br/>be undone, so the default is refusal"}}

subgraph LOSS["LOSS = exact + 1.0 x censored + 0.25 x auxiliary"]
  direction LR
  LEX["EXACT · Huber, delta = measured sigma_rep<br/>Kd 0.945 · Ki 0.641 · IC50 0.671<br/>error inside the noise floor is free"]
  LCEN["CENSORED #40;16.6%#41; · one-sided hinge<br/>then the same Huber<br/>ZERO cost inside the bound"]
  LAUX["Tier B · weight 0.25<br/>structurally cannot reach<br/>the primary term"]
end

IBAM["iBAM export — residue x token AND bond x bond · p2l [B,8,L,T] · l2p [B,8,T,L] per layer<br/>unaveraged over heads · residue x token native,<br/>residue x atom DERIVED<br/>──────────────<br/>ranking uses l2p: p2l rows are softmax over tokens,<br/>so every residue total is 1 and cannot rank<br/>a column is a BOND; knowledge columns are flagged<br/>non-physical and are never drawn<br/>──────────────<br/>BOND MAP #40;new#41;: LiGhT's own bonds-by-bonds attention,<br/>per layer and per head. Rows sum to a constant so they<br/>cannot rank; column sums #40;hub#41; can. Missing row mass is<br/>what a bond drew from the knowledge nodes, reported.<br/>**Gated by a distance control**: a map explained by path<br/>length is topology, not chemistry"]

FISHING["DRUG FISHING — a locked benchmark, not an arm<br/>3,721 targets · 81,971 actives · 37,187 measured<br/>inactives · 1,926,939 property-matched decoys<br/>──────────────<br/>ranking actives against decoys is an evaluation<br/>of the trained predictor, so it needs no retrieval<br/>tower of its own. Listed unscored by `evaluate`<br/>because it asks a different question than affinity"]

LEGEND["LEGEND — solid: built and tested, not yet trained<br/>DOTTED + ✎: PLANNED, NOT BUILT — no code exists; shapes are from the spec"]


%% ============ PLANNED: DIFFUSION #40;Priority 3#41; ============
subgraph PDIFF["✎ ANALOG GENERATION — PLANNED, NOT BUILT"]
  direction TB
  DCOND["Conditioning: seed SMILES + scaffold policy from the caller ·<br/>target residues + endpoint · seed ligand<br/>representations · shared cross-attention features ·<br/>iBAM-derived edit context · preserved scaffold with<br/>atom mapping · optional requested affinity change"]
  DDEN["DiGress-style DISCRETE 2D graph diffusion<br/>categorical forward noising + reverse sampler<br/>denoiser predicts editable atom/bond categories<br/>from the noisy graph, timestep and conditions<br/>scaffold identities and stereochemistry held FIXED"]
  DDEC["Explicit RDKit decode → sanitize → verify scaffold<br/>by atom mapping → canonical isomeric SMILES<br/>validity reported BEFORE and after any repair"]
  DSCORE["re-encode candidates, score with the affinity ensemble<br/>#40;candidates re-enter the ligand arm above — also a loop#41;<br/>predicted improvement is a SELECTION HYPOTHESIS"]
  DNO{{"never condition on the clean product's<br/>representation: it is unavailable at inference<br/>and is a reconstruction shortcut<br/>──────────────<br/>discrete sampling and RDKit conversion are<br/>NOT differentiable — the gradient path stops here"}}
  DCOND --> DDEN --> DDEC --> DSCORE
  DDEN --- DNO
end

%% ============ PLANNED: UNCERTAINTY #40;Priority 4#41; ============
subgraph PUNC["✎ CALIBRATED UNCERTAINTY — PLANNED, NOT BUILT"]
  direction TB
  UENS["3 INDEPENDENTLY trained models<br/>#40;different init and data-order seeds, same partitions#41;<br/>three dropout passes are not three models<br/>report mean and SD in p-units"]
  UCONF["split conformal on a SEPARATE calibration partition<br/>q = kth smallest |y - mean| · 90% intervals per endpoint<br/>insufficient-calibration status rather than a made-up interval"]
  UDOM["applicability domain: similarity vs TRAINING entities only<br/>OOD flag reported independently of ensemble spread<br/>no coverage guarantee on a novel target"]
  UENS --> UCONF --> UDOM
end

PLOSS["✎ PLANNED JOINT OBJECTIVE — NOT BUILT<br/>L_total = L_affinity + λ_rank·L_within_assay_ranking<br/>+ λ_diffusion + λ_delta·L_measured_analog_delta<br/>+ λ_consistency<br/>──────────────<br/>only L_affinity exists today. Warm up affinity before raising<br/>auxiliary weights; no term may consume test or calibration labels"]

SEQ --> ESMC
SMI --> BUILD
CACHE -->|"[B, L, 1152] bf16"| AP
CONTRACT -->|"tokens + mask"| AL
CONTRACT -->|"graph_states"| AG

AP --> P2L
AP --> L2P
AL --> P2L
AL --> L2P

FFP --> POOL
FFL --> POOL
AG --> POOL
AP -.->|"pre-fusion bypass"| POOL

POOL --> HKD & HKI & HIC
HKD & HKI & HIC --> GATHER
GATHER --> LEX & LCEN & LAUX
GATHER -.->|"a finished checkpoint"| LOCK
LOCK -.-> FISHING
P2L -.-> IBAM
L2P -.-> IBAM

%% --- planned wiring. Dotted throughout: none of this exists. ---
%% Retrieval reads the UNCONDITIONED adapters, never the fused stream.

%% Generation is conditioned by the fused pair and by iBAM, per Upgrade A.
FFP -.-> DCOND
FFL -.-> DCOND
IBAM -.->|"edit context"| DCOND

%% Uncertainty wraps the trained predictor rather than sitting inside it.
GATHER -.-> UENS
LEX -.-> PLOSS
DDEN -.-> PLOSS

