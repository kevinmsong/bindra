# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
.venv/
tools/docking/python_packages/
tools/docking/*.exe
tools/structure/python_packages/
envs/*/.venv/

# Data, caches and model weights are large and/or licensed; they are
# reproduced from the recorded snapshot metadata, not committed.
data/raw/
data/processed/
data/cache/
# Third-party benchmark sets (Davis, KIBA) carry their own licences and are
# downloaded, not produced here. Same rule as the rest: reconstructed from
# their source, never vendored.
data/external/
*.pt
*.safetensors
*.npy
*.npz
*.parquet
*.tsv
*.tsv.gz

# Split manifests, benchmark manifests and snapshot provenance ARE committed:
# they are small, and reproducibility is the whole point. The bulk data they
# describe is reconstructed from them, not stored here.
!data/splits/**/*.json
!data/benchmarks/**/*.json

# iBAM exports: the .npz matrices ARE the artifact of record. bindra/ibam/plots.py
# is built on the claim that every figure can be re-derived from the file that
# produced it, so committing the figures while the blanket *.npz rule drops the
# matrices breaks precisely that guarantee. ~800 KB each, 2.5 MB in all.
!docs/figures/**/*.npz

# The split ID lists ARE committed too, deliberately, at ~38 MB gzipped. The
# whole discipline of this project is that the splits are locked and immutable;
# a split that only exists if you can re-run the builder against an 8.4 GB
# BindingDB snapshot is not locked in any useful sense. Each manifest carries
# the sha256 of its own ID files, so a rebuild can be checked byte-for-byte
# against what is here.
!data/splits/**/*.txt.gz

# Snapshots: commit the JSON records, never the archives. Order matters --
# re-include the directories first so git can descend into them, then allow
# only .json. Un-ignoring the directory itself (!data/snapshots/) would admit
# the 567 MB archive, which is how it got committed once already.
data/snapshots/**
!data/snapshots/**/
!data/snapshots/**/*.json

# Bulk archives, belt and braces.
*.zip
*.tar
*.tar.gz
*.sdf

# Run outputs
checkpoints/
logs/
results/
outputs/
wandb/

# Prospective study keys must never be committed: unblinding assignments
# would defeat the blinded design.
prospective/**/assignment_key*
prospective/**/*unblind*

# OS
.DS_Store
Thumbs.db
desktop.ini
runs/

# Submission manuscripts and compiled PDFs stay in the local authoring package.
*.[pP][dD][fF]
J_Cheminform_submission/
BMC_Bioinformatics_submission/
